{{-- Top navigation with mobile menu (signals-driven).
     Active link highlighting handled by the SPA router via aria-current
     on links the user lands on. --}}

<script client>
  const mobileMenu = state(false)

  function setMenu(open) {
    mobileMenu.set(open)
    document.documentElement.style.overflow = open ? 'hidden' : ''
  }

  function toggleMenu() {
    setMenu(!mobileMenu())
  }

  // Close the menu after SPA navigation so a link click in the open
  // overlay actually appears to navigate (otherwise the overlay still
  // covers the new page).
  const onNavigate = () => setMenu(false)

  onMount(() => {
    window.addEventListener('stx:navigate', onNavigate)
  })

  onDestroy(() => {
    window.removeEventListener('stx:navigate', onNavigate)
    document.documentElement.style.overflow = ''
  })
</script>

<nav class="fixed top-0 left-0 right-0 z-50 px-6 lg:px-12 py-4 flex justify-between items-center bg-white/90 dark:bg-black/90 backdrop-blur-xl border-b border-black/5 dark:border-white/5">
  <a href="/" class="z-50 text-xs font-bold tracking-[0.2em] uppercase">Paweł Dregan</a>

  <ul class="hidden md:flex items-center gap-10">
    <li><a href="/" class="text-xs font-medium tracking-wide text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">{t:nav.home}</a></li>
    <li><a href="/about" class="text-xs font-medium tracking-wide text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">{t:nav.about}</a></li>
    <li><a href="/races" class="text-xs font-medium tracking-wide text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">{t:nav.races}</a></li>
    <li><a href="/coaching" class="text-xs font-medium tracking-wide text-black/50 dark:text-white/50 hover:text-black dark:hover:text-white transition-colors">{t:nav.coaching}</a></li>
  </ul>

  <div class="flex items-center gap-5">
    <div class="hidden md:flex">
      <SocialLinks />
    </div>
    <LangPicker />
    <ThemeToggle />

    {{-- Mobile menu trigger --}}
    <button @click="toggleMenu()" class="flex md:hidden z-50 flex-col gap-1.5 items-center justify-center h-8 w-8" aria-label="Toggle menu">
      <span :class="mobileMenu() ? 'h-px w-5 bg-black dark:bg-white duration-300 transition-all origin-center rotate-45 translate-y-[4px]' : 'h-px w-5 bg-black dark:bg-white duration-300 transition-all origin-center'"></span>
      <span :class="mobileMenu() ? 'h-px w-5 bg-black dark:bg-white duration-300 transition-all origin-center -rotate-45 -translate-y-[4px]' : 'h-px w-5 bg-black dark:bg-white duration-300 transition-all origin-center'"></span>
    </button>
  </div>
</nav>

{{-- Mobile menu overlay --}}
<div :show="mobileMenu()" class="flex fixed inset-0 z-40 flex-col gap-8 items-center justify-center bg-white dark:bg-black md:hidden">
  <a href="/" @click="setMenu(false)" class="font-display text-4xl text-black/70 dark:text-white/70 tracking-tight hover:text-black dark:hover:text-white transition-colors">{t:nav.home}</a>
  <a href="/about" @click="setMenu(false)" class="font-display text-4xl text-black/70 dark:text-white/70 tracking-tight hover:text-black dark:hover:text-white transition-colors">{t:nav.about}</a>
  <a href="/races" @click="setMenu(false)" class="font-display text-4xl text-black/70 dark:text-white/70 tracking-tight hover:text-black dark:hover:text-white transition-colors">{t:nav.races}</a>
  <a href="/coaching" @click="setMenu(false)" class="font-display text-4xl text-black/70 dark:text-white/70 tracking-tight hover:text-black dark:hover:text-white transition-colors">{t:nav.coaching}</a>
  <div class="mt-8">
    <SocialLinks />
  </div>
</div>
