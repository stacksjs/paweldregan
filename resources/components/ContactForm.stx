{{-- Contact form. Posts to /api/contact (a server endpoint hosted on
     the mail-os EC2 box — see github issue #7/#8). On a deploy without
     that endpoint live, submission errors and the form falls back to
     the IG link below. --}}

<script client>
  // The framework's `:show` directive only reactively subscribes to
  // bare signal references (see SubscribeForm.stx for the same note),
  // so we model each state as its own boolean signal instead of a
  // single status string.
  const isSubmitting = state(false)
  const isSuccess = state(false)
  const isInvalid = state(false)
  const isRateLimited = state(false)
  const isError = state(false)

  function clearStatus() {
    isSubmitting.set(false)
    isSuccess.set(false)
    isInvalid.set(false)
    isRateLimited.set(false)
    isError.set(false)
  }

  // Per-browser rate limit, mirrored on the server for real enforcement.
  // 60s matches the spec in issue #8.
  const RATE_LIMIT_MS = 60_000
  const STORAGE_KEY = 'contact:lastSubmit'

  function emailLooksValid(value) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
  }

  async function onSubmit(event) {
    event.preventDefault()

    const form = event.target
    const data = new FormData(form)

    // Honeypot. Real users never fill this; bots usually do.
    // Pretend success so we don't tip them off.
    if ((data.get('website') || '').toString().trim() !== '') {
      clearStatus()
      isSuccess.set(true)
      form.reset()
      return
    }

    const name = (data.get('name') || '').toString().trim()
    const email = (data.get('email') || '').toString().trim()
    const message = (data.get('message') || '').toString().trim()

    if (!name || !email || !message || !emailLooksValid(email)) {
      clearStatus()
      isInvalid.set(true)
      return
    }

    try {
      const last = Number(localStorage.getItem(STORAGE_KEY) || 0)
      if (Date.now() - last < RATE_LIMIT_MS) {
        clearStatus()
        isRateLimited.set(true)
        return
      }
    } catch {}

    clearStatus()
    isSubmitting.set(true)
    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, email, message }),
      })
      if (!res.ok) throw new Error('contact endpoint returned ' + res.status)
      try { localStorage.setItem(STORAGE_KEY, String(Date.now())) } catch {}
      clearStatus()
      isSuccess.set(true)
      form.reset()
    } catch {
      clearStatus()
      isError.set(true)
    }
  }
</script>

<form @submit="onSubmit($event)" novalidate class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-6 max-w-[640px] mx-auto text-left">
  <div>
    <label for="contact-name" class="block text-[0.6rem] font-semibold tracking-[0.2em] uppercase text-black/40 dark:text-white/40 mb-3">{t:contact.name}</label>
    <input
      id="contact-name"
      name="name"
      type="text"
      required
      autocomplete="name"
      placeholder="{t:contact.namePlaceholder}"
      class="w-full bg-transparent border-b border-black/15 dark:border-white/15 focus:border-black dark:focus:border-white outline-none py-2 text-base placeholder-black/25 dark:placeholder-white/25 transition-colors"
    />
  </div>

  <div>
    <label for="contact-email" class="block text-[0.6rem] font-semibold tracking-[0.2em] uppercase text-black/40 dark:text-white/40 mb-3">{t:contact.email}</label>
    <input
      id="contact-email"
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="{t:contact.emailPlaceholder}"
      class="w-full bg-transparent border-b border-black/15 dark:border-white/15 focus:border-black dark:focus:border-white outline-none py-2 text-base placeholder-black/25 dark:placeholder-white/25 transition-colors"
    />
  </div>

  <div class="md:col-span-2">
    <label for="contact-message" class="block text-[0.6rem] font-semibold tracking-[0.2em] uppercase text-black/40 dark:text-white/40 mb-3">{t:contact.message}</label>
    <textarea
      id="contact-message"
      name="message"
      rows="5"
      required
      placeholder="{t:contact.messagePlaceholder}"
      class="w-full bg-transparent border-b border-black/15 dark:border-white/15 focus:border-black dark:focus:border-white outline-none py-2 text-base placeholder-black/25 dark:placeholder-white/25 transition-colors resize-none"
    ></textarea>
  </div>

  {{-- Honeypot. Hidden from humans (visually + from a11y tree), bots
       parsing the DOM see a normal field and fill it. --}}
  <div aria-hidden="true" class="hidden">
    <label for="contact-website">Website (leave blank)</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div class="md:col-span-2 flex flex-col gap-6 pt-2">
    <button
      type="submit"
      x-disabled="isSubmitting"
      class="self-start inline-flex items-center gap-2 px-8 py-4 bg-black dark:bg-white text-white dark:text-black text-sm font-semibold tracking-wide hover:bg-black/85 dark:hover:bg-white/85 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
    >
      <span :show="!isSubmitting">{t:contact.submit}</span>
      <span :show="isSubmitting">{t:contact.submitting}</span>
    </button>

    <div :show="isSuccess" class="text-sm text-black/55 dark:text-white/55 leading-relaxed">{t:contact.success}</div>
    <div :show="isInvalid" class="text-sm text-black/55 dark:text-white/55 leading-relaxed">{t:contact.invalid}</div>
    <div :show="isRateLimited" class="text-sm text-black/55 dark:text-white/55 leading-relaxed">{t:contact.rateLimited}</div>
    <div :show="isError" class="text-sm text-black/55 dark:text-white/55 leading-relaxed">{t:contact.error}</div>
  </div>
</form>
