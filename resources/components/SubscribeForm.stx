{{-- Newsletter subscribe form. Reactive state + fetch live in
     resources/stores/subscribe.ts; this component is markup +
     input bindings only. --}}

<script client>
  import type { SubscribeStore } from '~/resources/stores/subscribe'

  const subscribe = useStore('subscribe') as SubscribeStore

  // Pull each signal into a bare local so `:show="isSubmitting"` etc.
  // bind reactively — property access on the store object doesn't.
  const isSubmitting = subscribe.isSubmitting
  const isSuccess = subscribe.isSuccess
  const isInvalid = subscribe.isInvalid
  const isAlreadySubscribed = subscribe.isAlreadySubscribed
  const isError = subscribe.isError

  // Local controlled input. Two purposes: (1) gives the framework
  // a `state(...)` call so it wraps this component in `data-stx-scope`
  // (no scope = no `:show`/`x-disabled` binding), (2) lets the store's
  // `submit` resolve a clean string without pulling FormData out of
  // the event target.
  const email = state<string>('')

  async function onSubmit(event: SubmitEvent): Promise<void> {
    event.preventDefault()
    const ok = await subscribe.submit(email(), 'footer')
    if (ok) email.set('')
  }
</script>

<form @submit="onSubmit($event)" novalidate class="w-full md:w-[420px] flex flex-col gap-3">
  <div class="flex items-center gap-3 border-b border-black/15 dark:border-white/15 focus-within:border-black dark:focus-within:border-white transition-colors">
    <input
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="{t:subscribe.placeholder}"
      x-model="email"
      x-disabled="isSubmitting"
      class="flex-1 bg-transparent outline-none py-2 text-sm placeholder-black/25 dark:placeholder-white/25 disabled:opacity-50"
    />
    <button
      type="submit"
      x-disabled="isSubmitting"
      class="text-[0.6rem] font-semibold tracking-[0.25em] uppercase text-black/40 dark:text-white/40 hover:text-black dark:hover:text-white disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
    >
      <span :show="!isSubmitting">{t:subscribe.submit}</span>
      <span :show="isSubmitting">{t:subscribe.submitting}</span>
    </button>
  </div>

  <div :show="isSuccess" class="text-xs text-black/45 dark:text-white/45">{t:subscribe.success}</div>
  <div :show="isInvalid" class="text-xs text-black/45 dark:text-white/45">{t:subscribe.invalid}</div>
  <div :show="isAlreadySubscribed" class="text-xs text-black/45 dark:text-white/45">{t:subscribe.alreadySubscribed}</div>
  <div :show="isError" class="text-xs text-black/45 dark:text-white/45">{t:subscribe.error}</div>
</form>
