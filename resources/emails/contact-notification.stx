{{-- Internal notification sent to hello@paweldregan.com whenever
     someone submits the /coaching contact form. All copy + locale
     handling lives in app/Mail/ContactNotification.ts — this template
     is pure structure so the stx <script server> sandbox (which
     surfaced "Attempted to assign to readonly property" on common
     identifiers like `name`/`message`) never has to evaluate any JS. --}}

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #f6f6f6; color: #111;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%;">
    <tr>
      <td style="padding: 32px 16px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 560px; margin: 0 auto; background-color: #ffffff; border: 1px solid #e5e5e5;">

          <tr>
            <td style="padding: 28px 32px 0;">
              <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #999;">NEW CONTACT SUBMISSION</span>
              <h1 style="font-size: 20px; line-height: 1.3; color: #111; margin: 12px 0 24px; font-weight: 600;">{{ senderName }} got in touch</h1>
            </td>
          </tr>

          <tr>
            <td style="padding: 0 32px 16px;">
              <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; font-size: 14px; color: #333;">
                <tr>
                  <td style="padding: 6px 0; color: #888; width: 100px;">Name</td>
                  <td style="padding: 6px 0;">{{ senderName }}</td>
                </tr>
                <tr>
                  <td style="padding: 6px 0; color: #888;">Email</td>
                  <td style="padding: 6px 0;"><a href="mailto:{{ senderEmail }}" style="color: #111;">{{ senderEmail }}</a></td>
                </tr>
                <tr>
                  <td style="padding: 6px 0; color: #888;">Locale</td>
                  <td style="padding: 6px 0;">{{ locale }}</td>
                </tr>
                <tr>
                  <td style="padding: 6px 0; color: #888;">IP</td>
                  <td style="padding: 6px 0;">{{ ipAddress }}</td>
                </tr>
                <tr>
                  <td style="padding: 6px 0; color: #888;">At</td>
                  <td style="padding: 6px 0;">{{ submittedAt }}</td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding: 16px 32px 28px;">
              <div style="border-top: 1px solid #eee; padding-top: 20px;">
                <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: #999;">Message</span>
                <p style="white-space: pre-wrap; font-size: 14px; line-height: 1.6; color: #222; margin: 12px 0 0;">{{ body }}</p>
              </div>
            </td>
          </tr>

          <tr>
            <td style="padding: 16px 32px 28px; background: #fafafa; border-top: 1px solid #eee;">
              <p style="font-size: 12px; color: #777; margin: 0;">Reply to this email — it goes directly to <strong>{{ senderName }}</strong> at {{ senderEmail }}.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
