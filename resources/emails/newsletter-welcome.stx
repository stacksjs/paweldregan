{{-- Welcome email for newsletter signups. All locale-aware copy is
     composed in app/Mail/NewsletterWelcome.ts so this template stays
     pure-structure — keeps the stx <script server> sandbox out of
     the picture entirely (see contact-notification.stx for the
     readonly-property failure we worked around). --}}

<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; background-color: #000000; color: #ffffff;">
  <table role="presentation" cellpadding="0" cellspacing="0" style="width: 100%; border-collapse: collapse; background-color: #000000;">
    <tr>
      <td style="padding: 48px 24px;">
        <table role="presentation" cellpadding="0" cellspacing="0" style="max-width: 520px; margin: 0 auto;">

          <tr>
            <td style="padding-bottom: 40px;">
              <span style="font-size: 11px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase; color: rgba(255,255,255,0.4);">PAWEŁ DREGAN</span>
            </td>
          </tr>

          <tr>
            <td>
              <h1 style="font-family: 'Bebas Neue', Impact, sans-serif; font-size: 44px; line-height: 1; letter-spacing: -0.01em; color: #ffffff; margin: 0 0 24px;">{{ heading }}</h1>

              <p style="font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.55); margin: 0 0 32px;">{{ intro }}</p>

              <p style="font-size: 15px; line-height: 1.6; color: rgba(255,255,255,0.55); margin: 0 0 8px;">{{ nextWord }}</p>
              <p style="font-size: 15px; line-height: 1.6; color: #ffffff; margin: 0 0 40px;">{{ sign }}</p>

              <table role="presentation" cellpadding="0" cellspacing="0">
                <tr>
                  <td>
                    <a href="{{ siteUrl }}" style="display: inline-block; border: 1px solid rgba(255,255,255,0.2); color: #ffffff; text-decoration: none; padding: 12px 24px; font-size: 11px; font-weight: 600; letter-spacing: 0.25em; text-transform: uppercase;">{{ visit }} →</a>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <tr>
            <td style="padding-top: 64px; border-top: 1px solid rgba(255,255,255,0.05);">
              <p style="font-size: 11px; line-height: 1.6; color: rgba(255,255,255,0.25); margin: 24px 0 0;">{{ footer }}</p>
              <p style="font-size: 11px; line-height: 1.6; color: rgba(255,255,255,0.2); margin: 8px 0 0;">© {{ year }} Paweł Dregan</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
