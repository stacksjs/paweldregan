@extends('layouts/default')

@section('content')

<script server>
interface Race {
  date: string
  name: string
  sub: string
  flag: string
  category: string
  distance: string
  elevation: string
  time: string
  rank: string
  isDnf: boolean
}

const races: Race[] = [
  { date: '2025.08', name: 'SwissPeaks Trail 700K', sub: 'SwissPeaks Trail 2025', flag: '🇨🇭', category: '100M', distance: '700 km', elevation: '49,000 m+', time: '175:43:56', rank: '9 / 55', isDnf: false },
  { date: '2025.07', name: 'PIUT100', sub: 'PIUT 2025', flag: '🇮🇹', category: '100K', distance: '101.1 km', elevation: '6,300 m+', time: '20:21:53', rank: '16 / 23', isDnf: false },
  { date: '2025.05', name: 'K110 — Masters of Innsbruck', sub: 'Innsbruck Alpine Trailrun Festival 2025', flag: '🇦🇹', category: '100K', distance: '108.3 km', elevation: '5,600 m+', time: '—', rank: 'DNF', isDnf: true },
  { date: '2024.07', name: 'E250 — UNESCO Trail', sub: 'Eiger Ultra Trail by UTMB 2024', flag: '🇨🇭', category: '100M', distance: '254 km', elevation: '14,945 m+', time: '70:42:49', rank: '17 / 118', isDnf: false },
  { date: '2023.11', name: 'KoBoLT 140 KM', sub: 'kleiner KoBoLT 2023', flag: '🇩🇪', category: '100M', distance: '140 km', elevation: '4,450 m+', time: '19:57:00', rank: '6 / 30', isDnf: false },
  { date: '2023.08', name: '{t:races.name.100miles}', sub: 'KAT100 by UTMB 2023', flag: '🇦🇹', category: '100M', distance: '160 km', elevation: '9,820 m+', time: '36:15:50', rank: '40 / 57', isDnf: false },
  { date: '2023.06', name: 'K85 — Heart of the Alps Ultra', sub: 'Innsbruck Alpine Trailrun Festival 2023', flag: '🇦🇹', category: '100K', distance: '88 km', elevation: '3,490 m+', time: '15:43:01', rank: '38 / 110', isDnf: false },
  { date: '2022.08', name: 'P105 — Salomon Ultra', sub: 'Pitz Alpine Glacier Trail 2022', flag: '🇦🇹', category: '100M', distance: '106 km', elevation: '6,430 m+', time: '26:31:54', rank: '22 / 22', isDnf: false },
  { date: '2020.07', name: '{t:races.name.100mile}', sub: 'Chiemgauer 100 2020', flag: '🇩🇪', category: '100M', distance: '160.9 km', elevation: '7,500 m+', time: '31:47:42', rank: '7 / 11', isDnf: false },
]
</script>

{{-- Header. Photo flanks the title on lg+ (4-col span title, 2-col span
    photo) to anchor the race list with a finish-line image. Stacked on
    mobile with the photo below the lede. --}}
<header class="mx-auto pb-16 pt-40 px-6 lg:pt-48 lg:px-12 max-w-[1400px]">
  <div class="grid gap-12 grid-cols-1 items-end lg:gap-16 lg:grid-cols-[1.4fr_1fr]">
    <div>
      <span class="block mb-8 font-semibold text-[0.6rem] text-black/25 tracking-[0.25em] uppercase dark:text-white/25">{t:races.kicker}</span>
      <h1 class="font-display leading-[0.85] text-[clamp(4rem,9vw,8rem)] tracking-tight">{t:races.title}</h1>
      <p class="mt-8 max-w-[560px] leading-relaxed text-base text-black/35 dark:text-white/35">
        {t:races.lede}
      </p>
    </div>
    <div>
      <StxImage
        src="/images/ultra700.jpg"
        alt="SwissPeaks Trail 700K"
        class="aspect-[3/4] object-cover w-full"
        lazy="false"
      />
    </div>
  </div>
</header>

<div class="mx-auto px-6 lg:px-12 max-w-[1400px]">

  {{-- Summary Stats --}}
  <div class="grid grid-cols-2 lg:grid-cols-4 mb-16 border-black/5 border-t dark:border-white/5">
    <div class="p-8 border-b border-black/5 border-r dark:border-white/5">
      <div class="font-extrabold text-3xl tracking-tight">9</div>
      <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:races.stats.utmbRaces}</div>
    </div>
    <div class="p-8 border-b border-black/5 lg:border-r dark:border-white/5">
      <div class="font-extrabold text-3xl tracking-tight">700km</div>
      <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:races.stats.longest}</div>
    </div>
    <div class="p-8 border-b border-black/5 border-r dark:border-white/5">
      <div class="font-extrabold text-3xl tracking-tight">49,000m</div>
      <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:races.stats.elevation}</div>
    </div>
    <div class="p-8 border-b border-black/5 dark:border-white/5">
      <div class="font-extrabold text-3xl tracking-tight">8 / 9</div>
      <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:races.stats.finishRate}</div>
    </div>
  </div>

  {{-- Race Table --}}
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-black/10 dark:border-white/10">
          <th class="px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.date}</th>
          <th class="px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.race}</th>
          <th class="hidden md:table-cell px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.category}</th>
          <th class="px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.distance}</th>
          <th class="hidden lg:table-cell px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.elevation}</th>
          <th class="px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-left tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.time}</th>
          <th class="px-4 py-4 font-semibold text-[0.55rem] text-black/25 text-right tracking-[0.15em] uppercase dark:text-white/25">{t:races.table.rank}</th>
        </tr>
      </thead>
      <tbody>
        @foreach (races as race)
          <tr class="hover:bg-black/[0.02] dark:hover:bg-white/[0.02] border-b border-black/[0.03] dark:border-white/[0.03] transition-colors">
            <td class="px-4 py-4 tabular-nums text-black/30 text-sm whitespace-nowrap dark:text-white/30">{{ race.date }}</td>
            <td class="px-4 py-4">
              <div class="font-semibold text-sm">{{ race.flag }} {{ race.name }}</div>
              <div class="hidden md:block mt-0.5 text-black/25 text-xs dark:text-white/25">{{ race.sub }}</div>
            </td>
            <td class="hidden md:table-cell px-4 py-4">
              <span class="inline-block px-2.5 py-1 font-semibold text-[0.65rem] text-black/50 dark:text-white/50 border border-black/10 dark:border-white/10">{{ race.category }}</span>
            </td>
            <td class="px-4 py-4 font-medium tabular-nums text-sm">{{ race.distance }}</td>
            <td class="hidden lg:table-cell px-4 py-4 tabular-nums text-black/35 text-sm dark:text-white/35">{{ race.elevation }}</td>
            @if (race.isDnf)
              <td class="px-4 py-4 italic text-black/15 text-sm dark:text-white/15">DNF</td>
              <td class="px-4 py-4 italic text-black/15 text-right text-sm dark:text-white/15">—</td>
            @else
              <td class="px-4 py-4 font-medium tabular-nums text-sm">{{ race.time }}</td>
              <td class="px-4 py-4 font-bold tabular-nums text-right text-sm">{{ race.rank }}</td>
            @endif
          </tr>
        @endforeach
      </tbody>
    </table>
  </div>
</div>

@endsection
