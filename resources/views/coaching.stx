@extends('layouts/default')

@section('content')

<script server>
interface Service {
  number: string
  title: string
  description: string
  includes: string[]
}

interface ProcessStep {
  number: string
  title: string
  description: string
}

// {t:key} tokens stay literal — the framework's translation pass replaces
// them with the active locale's value during the build.
const services: Service[] = [
  {
    number: '01',
    title: '{t:coaching.services.plans.title}',
    description: '{t:coaching.services.plans.desc}',
    includes: [
      '{t:coaching.services.plans.i1}',
      '{t:coaching.services.plans.i2}',
      '{t:coaching.services.plans.i3}',
      '{t:coaching.services.plans.i4}',
    ],
  },
  {
    number: '02',
    title: '{t:coaching.services.race.title}',
    description: '{t:coaching.services.race.desc}',
    includes: [
      '{t:coaching.services.race.i1}',
      '{t:coaching.services.race.i2}',
      '{t:coaching.services.race.i3}',
      '{t:coaching.services.race.i4}',
    ],
  },
  {
    number: '03',
    title: '{t:coaching.services.support.title}',
    description: '{t:coaching.services.support.desc}',
    includes: [
      '{t:coaching.services.support.i1}',
      '{t:coaching.services.support.i2}',
      '{t:coaching.services.support.i3}',
      '{t:coaching.services.support.i4}',
    ],
  },
]

const steps: ProcessStep[] = [
  { number: '01', title: '{t:coaching.process.step1}', description: '{t:coaching.process.step1Desc}' },
  { number: '02', title: '{t:coaching.process.step2}', description: '{t:coaching.process.step2Desc}' },
  { number: '03', title: '{t:coaching.process.step3}', description: '{t:coaching.process.step3Desc}' },
  { number: '04', title: '{t:coaching.process.step4}', description: '{t:coaching.process.step4Desc}' },
]
</script>

{{-- Header --}}
<header class="mx-auto pb-16 pt-40 px-6 lg:pt-48 lg:px-12 max-w-[1400px]">
  <span class="block mb-8 font-semibold text-[0.6rem] text-black/25 tracking-[0.25em] uppercase dark:text-white/25">{t:coaching.kicker}</span>
  <h1 class="font-display leading-[0.85] text-[clamp(4rem,9vw,8rem)] tracking-tight">{t:coaching.title}</h1>
  <p class="mt-8 max-w-[560px] leading-relaxed text-base text-black/35 dark:text-white/35">
    {t:coaching.lede}
  </p>
</header>

<div class="mx-auto px-6 lg:px-12 max-w-[1400px]">
  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Philosophy. Three-up at lg+: photo → lede → body so the coaching
      page leads with a sense of who's behind the program. --}}
  <div class="grid gap-12 grid-cols-1 items-start lg:gap-16 lg:grid-cols-[1fr_1.2fr_1fr] py-16 lg:py-24">
    <div>
      <StxImage
        src="/images/coach1.jpg"
        alt="Paweł Dregan"
        class="aspect-[3/4] object-cover w-full"
      />
    </div>
    <p class="font-light leading-relaxed text-2xl text-black/50 lg:text-3xl dark:text-white/50">
      {t!:coaching.philosophyLead}
    </p>
    <div>
      <p class="mb-6 leading-relaxed text-base text-black/35 dark:text-white/35">
        {t:coaching.philosophy1}
      </p>
      <p class="leading-relaxed text-base text-black/35 dark:text-white/35">
        {t:coaching.philosophy2}
      </p>
    </div>
  </div>

  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Credentials --}}
  <section class="py-16 lg:py-24">
    <h2 class="mb-12 font-display text-5xl tracking-tight lg:text-6xl">{t:coaching.whyTitle}</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 border-black/5 border-t dark:border-white/5">
      <div class="p-8 text-center border-b border-black/5 border-r dark:border-white/5">
        <div class="font-extrabold text-3xl tracking-tight">700km</div>
        <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:coaching.stats.longest}</div>
      </div>
      <div class="p-8 text-center border-b border-black/5 lg:border-r dark:border-white/5">
        <div class="font-extrabold text-3xl tracking-tight">2nd</div>
        <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:coaching.stats.lappland}</div>
      </div>
      <div class="p-8 text-center border-b border-black/5 border-r dark:border-white/5">
        <div class="font-extrabold text-3xl tracking-tight">8 / 9</div>
        <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:coaching.stats.utmbRate}</div>
      </div>
      <div class="p-8 text-center border-b border-black/5 dark:border-white/5">
        <div class="font-extrabold text-3xl tracking-tight">5+</div>
        <div class="mt-3 font-medium text-[0.6rem] text-black/20 tracking-[0.15em] uppercase dark:text-white/20">{t:coaching.stats.yearsRacing}</div>
      </div>
    </div>
  </section>

  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Services --}}
  <section class="py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-3">
      @foreach (services as service)
        <div class="flex flex-col p-10 lg:p-12 min-h-[360px] hover:bg-black/[0.015] dark:hover:bg-white/[0.015] border-black/5 border-t lg:border-l lg:border-t-0 dark:border-white/5 lg:first:border-l-0 transition-colors">
          <span class="mb-8 font-display leading-none text-6xl text-black/5 dark:text-white/5">{{ service.number }}</span>
          <h3 class="mb-4 font-extrabold text-xl tracking-tight">{{ service.title }}</h3>
          <p class="mb-auto leading-relaxed text-black/35 text-sm dark:text-white/35">{{ service.description }}</p>
          <ul class="flex flex-col gap-2 mt-8 pt-6 border-black/5 border-t dark:border-white/5">
            @foreach (service.includes as item)
              <li class="flex gap-2 items-center text-black/40 text-xs dark:text-white/40">
                <span class="text-black/10 dark:text-white/10">—</span> {{ item }}
              </li>
            @endforeach
          </ul>
        </div>
      @endforeach
    </div>
  </section>

  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Process --}}
  <section class="py-16 lg:py-24">
    <h2 class="mb-12 font-display text-5xl tracking-tight lg:text-6xl">{t:coaching.processTitle}</h2>
    <div class="flex flex-col">
      @foreach (steps as step)
        <div class="flex flex-col gap-2 lg:flex-row lg:gap-8 lg:items-baseline py-6 border-b border-black/5 dark:border-white/5">
          <span class="shrink-0 lg:w-[60px] font-semibold text-black/10 text-xs tracking-wide dark:text-white/10">{{ step.number }}</span>
          <span class="shrink-0 lg:w-[200px] font-bold text-base">{{ step.title }}</span>
          <span class="leading-relaxed text-black/35 text-sm dark:text-white/35">{{ step.description }}</span>
        </div>
      @endforeach
    </div>
  </section>

  {{-- Contact --}}
  <section class="py-24 lg:py-32">
    <div class="mb-16 text-center">
      <span class="block mb-6 font-semibold text-[0.6rem] text-black/25 tracking-[0.25em] uppercase dark:text-white/25">{t:contact.kicker}</span>
      <h2 class="mb-6 font-display leading-[0.85] text-[clamp(3rem,6vw,6rem)] tracking-tight">{t:coaching.ctaTitle}</h2>
      <p class="mx-auto max-w-[480px] leading-relaxed text-base text-black/35 dark:text-white/35">
        {t:contact.lede}
      </p>
    </div>

    <ContactForm />

    <p class="mt-12 text-black/35 text-center text-xs dark:text-white/35">
      <a href="https://www.instagram.com/ultrarunnerpaw" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">{t:contact.fallback}</a>
    </p>
  </section>
</div>

@endsection
