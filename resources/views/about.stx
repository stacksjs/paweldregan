@extends('layouts/default')

@section('content')

<script server>
interface Milestone {
  year: string
  title: string
  detail: string
}

interface BioDetail {
  label: string
  value: string
}

// {t:key} tokens are literal text — the framework's translation pass
// rewrites them per locale during the build.
const milestones: Milestone[] = [
  { year: '2025', title: '{t:about.milestone.lappland}', detail: '515 km · 6d 23h 27m' },
  { year: '2025', title: '{t:about.milestone.swisspeaks}', detail: '700 km · 175:43:56' },
  { year: '2024', title: '{t:about.milestone.eiger}', detail: '254 km · 70:42:49' },
  { year: '2023', title: '{t:about.milestone.kat100}', detail: '160 km · 36:15:50' },
  { year: '2023', title: '{t:about.milestone.kobolt}', detail: '140 km · 19:57:00' },
  { year: '2022', title: '{t:about.milestone.pitz}', detail: '106 km · 26:31:54' },
  { year: '2020', title: '{t:about.milestone.chiemgauer}', detail: '160.9 km · 31:47:42' },
]

const bioDetails: BioDetail[] = [
  { label: '{t:about.bioDetails.basedIn}', value: '{t:about.bioDetails.basedInValue}' },
  { label: '{t:about.bioDetails.specialty}', value: '{t:about.bioDetails.specialtyValue}' },
  { label: '{t:about.bioDetails.longestFinish}', value: '{t:about.bioDetails.longestFinishValue}' },
  { label: '{t:about.bioDetails.bestResult}', value: '{t:about.bioDetails.bestResultValue}' },
  { label: '{t:about.bioDetails.nextRace}', value: '{t:about.bioDetails.nextRaceValue}' },
  { label: '{t:about.bioDetails.coaching}', value: '{t:about.bioDetails.coachingValue}' },
]
</script>

{{-- Header --}}
<header class="mx-auto pb-16 pt-40 px-6 lg:pt-48 lg:px-12 max-w-[1400px]">
  <span class="block mb-8 font-semibold text-[0.6rem] text-black/25 tracking-[0.25em] uppercase dark:text-white/25">{t:about.kicker}</span>
  <h1 class="font-display leading-[0.85] text-[clamp(4rem,9vw,8rem)] tracking-tight">{t:about.title}</h1>
</header>

<div class="mx-auto px-6 lg:px-12 max-w-[1400px]">
  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Bio. Three columns at lg+: portrait → bio copy → details list. On
      mobile the portrait stacks above (smaller crop), bio below, details
      last so the page leads with face → story → quick facts. --}}
  <div class="grid gap-12 grid-cols-1 lg:gap-16 lg:grid-cols-[1fr_1.1fr_0.9fr] py-16 lg:py-24">
    <div>
      <StxImage
        src="/images/about.jpg"
        alt="Paweł Dregan"
        class="aspect-[3/4] object-cover w-full"
        lazy="false"
      />
    </div>
    <div>
      <p class="mb-6 leading-relaxed text-black/60 text-lg dark:text-white/60">
        {t:about.bio1}
      </p>
      <p class="mb-6 leading-relaxed text-base text-black/40 dark:text-white/40">
        {t:about.bio2}
      </p>
      <p class="leading-relaxed text-base text-black/40 dark:text-white/40">
        {t:about.bio3}
      </p>
    </div>
    <div>
      @foreach (bioDetails as detail)
        <div class="py-5 border-b border-black/5 dark:border-white/5">
          <div class="mb-2 font-semibold text-[0.55rem] text-black/20 tracking-[0.2em] uppercase dark:text-white/20">{{ detail.label }}</div>
          <div class="font-medium text-sm">{{ detail.value }}</div>
        </div>
      @endforeach
    </div>
  </div>

  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Milestones --}}
  <section class="py-16 lg:py-24">
    <h2 class="mb-12 font-display text-5xl tracking-tight lg:text-6xl">{t:about.milestones}</h2>
    <div class="flex flex-col">
      @foreach (milestones as milestone)
        <div class="flex items-baseline justify-between -mx-4 px-4 py-5 hover:bg-black/[0.015] dark:hover:bg-white/[0.015] border-b border-black/5 dark:border-white/5 transition-colors">
          <div class="flex gap-8 items-baseline lg:gap-12">
            <span class="shrink-0 w-16 font-semibold text-black/20 text-xs tracking-wide dark:text-white/20">{{ milestone.year }}</span>
            <span class="font-semibold text-base">{{ milestone.title }}</span>
          </div>
          <span class="hidden lg:block shrink-0 ml-8 text-black/30 text-sm dark:text-white/30">{{ milestone.detail }}</span>
        </div>
      @endforeach
    </div>
  </section>

  <div class="border-black/5 border-t dark:border-white/5"></div>

  {{-- Partners --}}
  <section class="py-16 lg:py-24">
    <h2 class="mb-12 font-display text-5xl tracking-tight lg:text-6xl">{t:about.partners}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="p-10 border-black/5 border-r border-t dark:border-white/5">
        <div class="mb-2 font-bold text-xl">Rappid.Runs</div>
        <div class="text-black/30 text-sm dark:text-white/30">{t:about.partner.rappidRole}</div>
      </div>
      <div class="p-10 border-black/5 border-t dark:border-white/5">
        <div class="mb-2 font-bold text-xl">Falke Sport</div>
        <div class="text-black/30 text-sm dark:text-white/30">{t:about.partner.falkeRole}</div>
      </div>
    </div>
  </section>
</div>

@endsection
