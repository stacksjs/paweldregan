@extends('layouts/default')

@section('content')

<script server>
interface Milestone {
  year: string
  title: string
  detail: string
}

interface BioDetail {
  label: string
  value: string
}

// {t:key} tokens are literal text — the framework's translation pass
// rewrites them per locale during the build.
const milestones: Milestone[] = [
  { year: '2025', title: '{t:about.milestone.lappland}', detail: '515 km · 6d 23h 27m' },
  { year: '2025', title: '{t:about.milestone.swisspeaks}', detail: '700 km · 175:43:56' },
  { year: '2024', title: '{t:about.milestone.eiger}', detail: '254 km · 70:42:49' },
  { year: '2023', title: '{t:about.milestone.kat100}', detail: '160 km · 36:15:50' },
  { year: '2023', title: '{t:about.milestone.kobolt}', detail: '140 km · 19:57:00' },
  { year: '2022', title: '{t:about.milestone.pitz}', detail: '106 km · 26:31:54' },
  { year: '2020', title: '{t:about.milestone.chiemgauer}', detail: '160.9 km · 31:47:42' },
]

const bioDetails: BioDetail[] = [
  { label: '{t:about.bioDetails.basedIn}', value: '{t:about.bioDetails.basedInValue}' },
  { label: '{t:about.bioDetails.specialty}', value: '{t:about.bioDetails.specialtyValue}' },
  { label: '{t:about.bioDetails.longestFinish}', value: '{t:about.bioDetails.longestFinishValue}' },
  { label: '{t:about.bioDetails.bestResult}', value: '{t:about.bioDetails.bestResultValue}' },
  { label: '{t:about.bioDetails.nextRace}', value: '{t:about.bioDetails.nextRaceValue}' },
  { label: '{t:about.bioDetails.coaching}', value: '{t:about.bioDetails.coachingValue}' },
]
</script>

{{-- Header --}}
<header class="pt-40 lg:pt-48 pb-16 px-6 lg:px-12 max-w-[1400px] mx-auto">
  <span class="text-[0.6rem] font-semibold tracking-[0.25em] uppercase text-black/25 dark:text-white/25 block mb-8">{t:about.kicker}</span>
  <h1 class="font-display text-[clamp(4rem,9vw,8rem)] leading-[0.85] tracking-tight">{t:about.title}</h1>
</header>

<div class="max-w-[1400px] mx-auto px-6 lg:px-12">
  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Bio --}}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 py-16 lg:py-24">
    <div>
      <p class="text-lg text-black/60 dark:text-white/60 leading-relaxed mb-6">
        {t:about.bio1}
      </p>
      <p class="text-base text-black/40 dark:text-white/40 leading-relaxed mb-6">
        {t:about.bio2}
      </p>
      <p class="text-base text-black/40 dark:text-white/40 leading-relaxed">
        {t:about.bio3}
      </p>
    </div>
    <div>
      @foreach (bioDetails as detail)
        <div class="py-5 border-b border-black/5 dark:border-white/5">
          <div class="text-[0.55rem] font-semibold tracking-[0.2em] uppercase text-black/20 dark:text-white/20 mb-2">{{ detail.label }}</div>
          <div class="text-sm font-medium">{{ detail.value }}</div>
        </div>
      @endforeach
    </div>
  </div>

  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Milestones --}}
  <section class="py-16 lg:py-24">
    <h2 class="font-display text-5xl lg:text-6xl tracking-tight mb-12">{t:about.milestones}</h2>
    <div class="flex flex-col">
      @foreach (milestones as milestone)
        <div class="flex items-baseline justify-between py-5 border-b border-black/5 dark:border-white/5 hover:bg-black/[0.015] dark:hover:bg-white/[0.015] -mx-4 px-4 transition-colors">
          <div class="flex items-baseline gap-8 lg:gap-12">
            <span class="text-xs font-semibold tracking-wide text-black/20 dark:text-white/20 w-16 shrink-0">{{ milestone.year }}</span>
            <span class="text-base font-semibold">{{ milestone.title }}</span>
          </div>
          <span class="text-sm text-black/30 dark:text-white/30 hidden lg:block shrink-0 ml-8">{{ milestone.detail }}</span>
        </div>
      @endforeach
    </div>
  </section>

  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Partners --}}
  <section class="py-16 lg:py-24">
    <h2 class="font-display text-5xl lg:text-6xl tracking-tight mb-12">{t:about.partners}</h2>
    <div class="grid grid-cols-1 md:grid-cols-2">
      <div class="border-t border-r border-black/5 dark:border-white/5 p-10">
        <div class="text-xl font-bold mb-2">Rappid.Runs</div>
        <div class="text-sm text-black/30 dark:text-white/30">{t:about.partner.rappidRole}</div>
      </div>
      <div class="border-t border-black/5 dark:border-white/5 p-10">
        <div class="text-xl font-bold mb-2">Falke Sport</div>
        <div class="text-sm text-black/30 dark:text-white/30">{t:about.partner.falkeRole}</div>
      </div>
    </div>
  </section>
</div>

@endsection
