{
  "name": "paweldregan",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Paweł Dregan — ultra runner, coach, husband.",
  "license": "MIT",
  "scripts": {
    "dev": "./buddy dev --frontend",
    "build": "bun build.ts",
    "preview": "bun preview.ts",
    "start": "./buddy serve",
    "start:api": "./buddy serve:api",
    "deploy": "./buddy deploy --prod --yes",
    "check-locales": "bun scripts/check-locales.ts",
    "verify": "bun scripts/verify.ts",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "typecheck": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "stx": "./buddy",
    "typecheck:app": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false",
    "types:check": "bun x --bun tsc --noEmit -p tsconfig.json --pretty false"
  },
  "system": {
    "bun": "^1.4.0",
    "sqlite": "^3.47.2"
  },
  "dependencies": {
    "stacks": "^0.72.86"
  },
  "devDependencies": {
    "better-dx": "^0.2.15"
  },
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  }
}
