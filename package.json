{
  "name": "paweldregan",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Paweł Dregan — ultra runner, coach, husband.",
  "license": "MIT",
  "scripts": {
    "dev": "./buddy dev --frontend",
    "build": "bun build.ts",
    "preview": "bun preview.ts",
    "start": "bun preview.ts",
    "deploy": "bun scripts/deploy.ts",
    "check-locales": "bun scripts/check-locales.ts",
    "verify": "bun scripts/verify.ts",
    "lint": "./buddy lint",
    "lint:fix": "./buddy lint:fix",
    "typecheck": "./buddy typecheck",
    "fresh": "./buddy fresh",
    "clean": "./buddy clean",
    "upgrade": "./buddy upgrade",
    "buddy": "./buddy",
    "stacks": "./buddy",
    "stx": "./buddy"
  },
  "system": {
    "bun": "^1.3.0",
    "sqlite": "^3.47.2"
  },
  "dependencies": {
    "@stacksjs/bun-queue": "workspace:*",
    "@stacksjs/ts-craft": "^0.0.2",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "stacks": "workspace:*"
  },
  "devDependencies": {
    "better-dx": "^0.2.12"
  },
  "workspaces": [
    "storage/framework/**"
  ],
  "git-hooks": {
    "pre-commit": {
      "staged-lint": {
        "*.{js,ts,json,yaml,yml,md}": "bunx --bun pickier lint --fix"
      }
    },
    "commit-msg": "bunx gitlint --edit .git/COMMIT_EDITMSG"
  },
  "overrides": {
    "@stacksjs/rpx": "0.11.5",
    "@stacksjs/stx": "0.2.52"
  }
}