{{-- Marketing layout: head + nav + main + footer.
     SEO meta (<title>, <meta description>, og/twitter, canonical, hreflang)
     is injected per-page by buildStaticSite from site.config.ts pages[*]. --}}

<script server>
import { analytics } from '../site.config'
</script>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  {{-- Favicon is auto-injected by site-builder from site.config.ts seo.favicon --}}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

  <style>
    .font-display { font-family: 'Bebas Neue', Impact, sans-serif; }
    @keyframes scroll { 0% { transform: translateX(0); } 100% { transform: translateX(-50%); } }
  </style>

  {{-- @stacksjs/ts-analytics loader. Pulls tracker.js async, queues an
       initial pageview, and re-fires on stx:navigate so SPA route
       changes count too. siteId + endpoint live in site.config.ts. --}}
  <script>
    (function (w, d, s, endpoint, siteId) {
      w.sa = w.sa || function () { (w.sa.q = w.sa.q || []).push(arguments) }
      var f = d.getElementsByTagName(s)[0], j = d.createElement(s)
      j.async = 1
      j.src = endpoint + '/sites/' + siteId + '/tracker.js'
      f.parentNode.insertBefore(j, f)
      w.sa('init', siteId)
      w.sa('pageview')
      w.addEventListener('stx:navigate', function () { w.sa('pageview') })
    })(window, document, 'script', {{ analytics.endpoint }}, {{ analytics.siteId }})
  </script>
</head>

<body class="bg-white dark:bg-black text-black dark:text-white font-sans antialiased">

  <Nav />

  <main>
    @yield('content')
  </main>

  <Footer />

</body>
</html>
