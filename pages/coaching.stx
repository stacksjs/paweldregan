@extends('layouts/default')

@section('content')

<script server>
interface Service {
  number: string
  title: string
  description: string
  includes: string[]
}

interface ProcessStep {
  number: string
  title: string
  description: string
}

// {t:key} tokens stay literal — the framework's translation pass replaces
// them with the active locale's value during the build.
const services: Service[] = [
  {
    number: '01',
    title: '{t:coaching.services.plans.title}',
    description: '{t:coaching.services.plans.desc}',
    includes: [
      '{t:coaching.services.plans.i1}',
      '{t:coaching.services.plans.i2}',
      '{t:coaching.services.plans.i3}',
      '{t:coaching.services.plans.i4}',
    ],
  },
  {
    number: '02',
    title: '{t:coaching.services.race.title}',
    description: '{t:coaching.services.race.desc}',
    includes: [
      '{t:coaching.services.race.i1}',
      '{t:coaching.services.race.i2}',
      '{t:coaching.services.race.i3}',
      '{t:coaching.services.race.i4}',
    ],
  },
  {
    number: '03',
    title: '{t:coaching.services.support.title}',
    description: '{t:coaching.services.support.desc}',
    includes: [
      '{t:coaching.services.support.i1}',
      '{t:coaching.services.support.i2}',
      '{t:coaching.services.support.i3}',
      '{t:coaching.services.support.i4}',
    ],
  },
]

const steps: ProcessStep[] = [
  { number: '01', title: '{t:coaching.process.step1}', description: '{t:coaching.process.step1Desc}' },
  { number: '02', title: '{t:coaching.process.step2}', description: '{t:coaching.process.step2Desc}' },
  { number: '03', title: '{t:coaching.process.step3}', description: '{t:coaching.process.step3Desc}' },
  { number: '04', title: '{t:coaching.process.step4}', description: '{t:coaching.process.step4Desc}' },
]
</script>

{{-- Header --}}
<header class="pt-40 lg:pt-48 pb-16 px-6 lg:px-12 max-w-[1400px] mx-auto">
  <span class="text-[0.6rem] font-semibold tracking-[0.25em] uppercase text-black/25 dark:text-white/25 block mb-8">{t:coaching.kicker}</span>
  <h1 class="font-display text-[clamp(4rem,9vw,8rem)] leading-[0.85] tracking-tight">{t:coaching.title}</h1>
  <p class="text-base text-black/35 dark:text-white/35 leading-relaxed max-w-[560px] mt-8">
    {t:coaching.lede}
  </p>
</header>

<div class="max-w-[1400px] mx-auto px-6 lg:px-12">
  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Philosophy --}}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-24 py-16 lg:py-24">
    <p class="text-2xl lg:text-3xl font-light leading-relaxed text-black/50 dark:text-white/50">
      {t!:coaching.philosophyLead}
    </p>
    <div>
      <p class="text-base text-black/35 dark:text-white/35 leading-relaxed mb-6">
        {t:coaching.philosophy1}
      </p>
      <p class="text-base text-black/35 dark:text-white/35 leading-relaxed">
        {t:coaching.philosophy2}
      </p>
    </div>
  </div>

  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Credentials --}}
  <section class="py-16 lg:py-24">
    <h2 class="font-display text-5xl lg:text-6xl tracking-tight mb-12">{t:coaching.whyTitle}</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-black/5 dark:border-white/5">
      <div class="p-8 text-center border-b border-r border-black/5 dark:border-white/5">
        <div class="text-3xl font-extrabold tracking-tight">700km</div>
        <div class="text-[0.6rem] font-medium tracking-[0.15em] uppercase text-black/20 dark:text-white/20 mt-3">{t:coaching.stats.longest}</div>
      </div>
      <div class="p-8 text-center border-b border-black/5 dark:border-white/5 lg:border-r">
        <div class="text-3xl font-extrabold tracking-tight">2nd</div>
        <div class="text-[0.6rem] font-medium tracking-[0.15em] uppercase text-black/20 dark:text-white/20 mt-3">{t:coaching.stats.lappland}</div>
      </div>
      <div class="p-8 text-center border-b border-r border-black/5 dark:border-white/5">
        <div class="text-3xl font-extrabold tracking-tight">8 / 9</div>
        <div class="text-[0.6rem] font-medium tracking-[0.15em] uppercase text-black/20 dark:text-white/20 mt-3">{t:coaching.stats.utmbRate}</div>
      </div>
      <div class="p-8 text-center border-b border-black/5 dark:border-white/5">
        <div class="text-3xl font-extrabold tracking-tight">5+</div>
        <div class="text-[0.6rem] font-medium tracking-[0.15em] uppercase text-black/20 dark:text-white/20 mt-3">{t:coaching.stats.yearsRacing}</div>
      </div>
    </div>
  </section>

  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Services --}}
  <section class="py-16 lg:py-24">
    <div class="grid grid-cols-1 lg:grid-cols-3">
      @foreach (services as service)
        <div class="border-t border-black/5 dark:border-white/5 lg:border-t-0 lg:border-l lg:first:border-l-0 p-10 lg:p-12 flex flex-col min-h-[360px] hover:bg-black/[0.015] dark:hover:bg-white/[0.015] transition-colors">
          <span class="font-display text-6xl text-black/5 dark:text-white/5 leading-none mb-8">{{ service.number }}</span>
          <h3 class="text-xl font-extrabold tracking-tight mb-4">{{ service.title }}</h3>
          <p class="text-sm text-black/35 dark:text-white/35 leading-relaxed mb-auto">{{ service.description }}</p>
          <ul class="mt-8 pt-6 border-t border-black/5 dark:border-white/5 flex flex-col gap-2">
            @foreach (service.includes as item)
              <li class="text-xs text-black/40 dark:text-white/40 flex items-center gap-2">
                <span class="text-black/10 dark:text-white/10">—</span> {{ item }}
              </li>
            @endforeach
          </ul>
        </div>
      @endforeach
    </div>
  </section>

  <div class="border-t border-black/5 dark:border-white/5"></div>

  {{-- Process --}}
  <section class="py-16 lg:py-24">
    <h2 class="font-display text-5xl lg:text-6xl tracking-tight mb-12">{t:coaching.processTitle}</h2>
    <div class="flex flex-col">
      @foreach (steps as step)
        <div class="flex flex-col lg:flex-row lg:items-baseline gap-2 lg:gap-8 py-6 border-b border-black/5 dark:border-white/5">
          <span class="text-xs font-semibold text-black/10 dark:text-white/10 tracking-wide lg:w-[60px] shrink-0">{{ step.number }}</span>
          <span class="text-base font-bold lg:w-[200px] shrink-0">{{ step.title }}</span>
          <span class="text-sm text-black/35 dark:text-white/35 leading-relaxed">{{ step.description }}</span>
        </div>
      @endforeach
    </div>
  </section>

  {{-- Contact --}}
  <section class="py-24 lg:py-32">
    <div class="text-center mb-16">
      <span class="text-[0.6rem] font-semibold tracking-[0.25em] uppercase text-black/25 dark:text-white/25 block mb-6">{t:contact.kicker}</span>
      <h2 class="font-display text-[clamp(3rem,6vw,6rem)] leading-[0.85] tracking-tight mb-6">{t:coaching.ctaTitle}</h2>
      <p class="text-base text-black/35 dark:text-white/35 max-w-[480px] mx-auto leading-relaxed">
        {t:contact.lede}
      </p>
    </div>

    <ContactForm />

    <p class="text-center text-xs text-black/35 dark:text-white/35 mt-12">
      <a href="https://www.instagram.com/ultrarunnerpaw" target="_blank" rel="noopener noreferrer" class="hover:text-black dark:hover:text-white transition-colors">{t:contact.fallback}</a>
    </p>
  </section>
</div>

@endsection
