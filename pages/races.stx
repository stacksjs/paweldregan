  {{-- Race Table --}}
  <div class="overflow-x-auto">
    <table class="w-full border-collapse">
      <thead>
        <tr class="border-b border-black/10 dark:border-white/10">
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25">{t:races.table.date}</th>
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25">{t:races.table.race}</th>
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25 hidden md:table-cell">{t:races.table.category}</th>
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25">{t:races.table.distance}</th>
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25 hidden lg:table-cell">{t:races.table.elevation}</th>
          <th class="text-left py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25">{t:races.table.time}</th>
          <th class="text-right py-4 px-4 text-[0.55rem] font-semibold tracking-[0.15em] uppercase text-black/25 dark:text-white/25">{t:races.table.rank}</th>
        </tr>
      </thead>
      <tbody>
        @foreach (races as race)
          <tr class="border-b border-black/[0.03] dark:border-white/[0.03] hover:bg-black/[0.02] dark:hover:bg-white/[0.02] transition-colors">
            <td class="py-4 px-4 text-sm text-black/30 dark:text-white/30 tabular-nums whitespace-nowrap">{{ race.date }}</td>
            <td class="py-4 px-4">
              <div class="text-sm font-semibold">{{ race.flag }} {{ race.name }}</div>
              <div class="text-xs text-black/25 dark:text-white/25 mt-0.5 hidden md:block">{{ race.sub }}</div>
            </td>
            <td class="py-4 px-4 hidden md:table-cell">
              <span class="inline-block px-2.5 py-1 border border-black/10 dark:border-white/10 text-[0.65rem] font-semibold text-black/50 dark:text-white/50">{{ race.category }}</span>
            </td>
            <td class="py-4 px-4 text-sm font-medium tabular-nums">{{ race.distance }}</td>
            <td class="py-4 px-4 text-sm text-black/35 dark:text-white/35 tabular-nums hidden lg:table-cell">{{ race.elevation }}</td>
            @if (race.isDnf)
              <td class="py-4 px-4 text-sm text-black/15 dark:text-white/15 italic">DNF</td>
              <td class="py-4 px-4 text-sm text-black/15 dark:text-white/15 italic text-right">—</td>
            @else
              <td class="py-4 px-4 text-sm font-medium tabular-nums">{{ race.time }}</td>
              <td class="py-4 px-4 text-sm font-bold tabular-nums text-right">{{ race.rank }}</td>
            @endif
          </tr>
        @endforeach
      </tbody>
    </table>
  </div>
