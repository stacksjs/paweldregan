  <div class="grid grid-cols-2 lg:grid-cols-4 border-t border-black/5 dark:border-white/5 mb-16">
    <div class="p-8 border-b border-r border-black/5 dark:border-white/5">
      <div class="text-3xl font-extrabold tracking-tight">9</div>
      <div class="text-[0.6rem] font-medium tracking-[0.15em] uppercase text-black/20 dark:text-white/20 mt-3">{t:races.stats.utmbRaces}</div>
